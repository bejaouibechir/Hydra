{
  "name": "hydraetl-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:mockup-chatbot": "esbuild ../documentations/mockups/assets/hydra-chatbot-entry.ts --bundle --platform=browser --format=iife --target=es2020 --minify --legal-comments=none --outfile=../documentations/mockups/assets/hydra-chatbot-engine.js",
    "preview": "astro preview",
    "test:chatbot": "vitest run --config vitest.config.mjs",
    "test:playground": "playwright test tests/playground-chatbot.spec.ts",
    "lint:js": "eslint src --ext .js,.jsx,.astro --fix || true",
    "lint:html": "htmlhint dist || true",
    "test:lighthouse": "lighthouse https://hydraetl.com --output-path=./lighthouse.html || true",
    "test": "playwright test || true"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/react": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^1.0.0",
    "pagefind": "^1.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-astro": "^0.30.0",
    "esbuild": "^0.25.12",
    "htmlhint": "^1.1.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "playwright": "^1.40.0"
  }
}
