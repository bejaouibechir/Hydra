---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Hydra</title>
    <link rel="stylesheet" href="../../styles/global.css" />
  </head>
  <body>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #fff;
    --bg-soft: #f6f8f8;
    --text: #0e1a17;
    --text-soft: #5a6a66;
    --accent: #0f766e;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  html[data-theme="dark"] {
    --bg: #0d1412;
    --bg-soft: #111b18;
    --text: #e7efec;
    --text-soft: #9db0aa;
    --accent: #2dd4bf;
  }

  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    line-height: 1.5;
  }

  .wrap {
    max-width: 1220px;
    margin: 0 auto;
    padding: 22px clamp(12px, 3vw, 22px) 70px;
  }
</style>
