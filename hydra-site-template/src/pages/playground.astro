/* chatbot — local deterministic Hydra DSL engine */
function setChat(open){
  $("chatWrap").classList.toggle("open",open);
  $("chatWrap").setAttribute("aria-hidden",String(!open));
  $("chatLauncher").setAttribute("aria-expanded",String(open));
  if(open)setTimeout(function(){$("chatIn").focus();},80);else $("chatLauncher").focus();
}
function closeChat(){setChat(false);}
$("chatLauncher").onclick=function(){setChat(!$("chatWrap").classList.contains("open"));};
$("chatClose").onclick=closeChat;
var chatBusy=false,chatRequestCounter=0;
function currentChatOperation(){var steps=parseSteps($("fTransform").value);return steps.length?steps[0].op:undefined;}
function currentFiles(){return {"sources.yaml":$("fSources").value,"transformations.yaml":$("fTransform").value,"destinations.yaml":$("fDest").value,"pipeline.yaml":$("fPipeline").value};}
function containsPotentialSecret(files){var text=Object.values(files).join("\n");return /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/i.test(text)||/(?:api[_ -]?key|access[_ -]?token|password|secret)\s*[:=]\s*(?!["']?\$\{ENV:)[^\s"'{}$]{6,}/i.test(text);}
function chatContext(){
  var op=currentChatOperation(),msg=$("validationMsg"),files=currentFiles(),validationErrors=[];
  if(msg.classList.contains("err")&&msg.textContent)validationErrors.push({message:msg.textContent,path:"transformations.yaml"});
  return {hydraVersion:"1.2.0",dslVersion:"1.1",selectedOperation:op,currentDsl:$("fTransform").value,currentFiles:files,inputRows:(SRC_DATA[activeSrc]||SRC_DATA.orders).rows.slice(0,50),outputRows:lastOutputRows.slice(0,50),validationErrors:validationErrors,executionMode:"local_simulation",containsPotentialSecret:containsPotentialSecret(files)};
}
function newChatRequestId(){chatRequestCounter+=1;return "playground-"+Date.now()+"-"+chatRequestCounter;}
function appendChatMessage(who,text,variant){
  var row=document.createElement("div"),avatar=document.createElement("div"),bubble=document.createElement("div");
  row.className="msg "+who+(variant?" "+variant:"");avatar.className="av";avatar.textContent=who==="bot"?"Hy":"you";bubble.className="bub";bubble.textContent=text;
  row.append(avatar,bubble);$("chatMsgs").appendChild(row);$("chatMsgs").scrollTop=$("chatMsgs").scrollHeight;return {row:row,bubble:bubble};
}
function renderChatResponse(response,question){
  var variant=response.scopeDecision==="secret_warning"||response.scopeDecision==="no_match"?"warning":"";
  var message=appendChatMessage("bot",response.answer,variant),bubble=message.bubble;
  var meta=document.createElement("div");meta.className="chat-meta";
  var confidence=document.createElement("span");confidence.textContent="Match "+Math.round(response.confidence*100)+"%";
  var level=document.createElement("span");level.textContent=response.assistanceLevel.replace("_"," ");
  var scope=document.createElement("span");scope.className="scope";scope.textContent=response.scopeDecision.replaceAll("_"," ");meta.append(confidence,level,scope);bubble.appendChild(meta);
  if(response.citations.length){var citations=document.createElement("div");citations.className="chat-citations";response.citations.forEach(function(citation){var a=document.createElement("a");a.href=citation.href;a.textContent=citation.label;a.title=citation.kind;citations.appendChild(a);});bubble.appendChild(citations);}
  if(response.actions.length){var actions=document.createElement("div");actions.className="chat-actions";response.actions.forEach(function(action){var button=document.createElement("button");button.type="button";button.className="chat-action";button.textContent=action.label;button.onclick=function(){handleChatAction(action,question);};actions.appendChild(button);});bubble.appendChild(actions);}
  $("chatMsgs").scrollTop=$("chatMsgs").scrollHeight;
}
function setChatBusy(busy){chatBusy=busy;$("chatIn").disabled=busy;$("chatSend").disabled=busy;$("chatWrap").setAttribute("aria-busy",String(busy));}
function loadCorpusExample(exampleId){
  var example=(window.hydraChat?.examples||[]).find(function(item){return item.id===exampleId;});if(!example)return false;
  if(example.files){if(example.files["sources.yaml"])$("fSources").value=example.files["sources.yaml"];if(example.files["transformations.yaml"])$("fTransform").value=example.files["transformations.yaml"];if(example.files["destinations.yaml"])$("fDest").value=example.files["destinations.yaml"];if(example.files["pipeline.yaml"])$("fPipeline").value=example.files["pipeline.yaml"];}
  else if(example.yaml&&example.kind==="transformation")$("fTransform").value=example.yaml;
  else if(example.yaml&&example.kind==="source")$("fSources").value=example.yaml;
  else if(example.yaml&&example.kind==="destination")$("fDest").value=example.yaml;
  else return false;
  updateYamlEditor();parseDest();validate();markStale("Chat example loaded — run to update");pushYamlHistory();return true;
}
function handleChatAction(action,question){
  if(action.type==="show_next_hint"){chatAsk(question,"hint_2",false);return;}
  if(action.type==="show_solution"){chatAsk(question,"solution",false);return;}
  if(action.type==="load_example"){appendChatMessage("bot",loadCorpusExample(action.exampleId)?"The matched example is now loaded in the Playground editor.":"This example cannot be loaded in the current editor. Open its Learn lesson instead.","");return;}
  if(action.href)window.location.assign(action.href);
}
function chatAsk(q,assistanceLevel,showUser){
  q=(q||$("chatIn").value).trim();if(!q||chatBusy)return;if(showUser!==false)appendChatMessage("user",q,"");$("chatIn").value="";setChatBusy(true);
  var thinking=appendChatMessage("bot","Checking the local Hydra DSL corpus…","thinking");
  setTimeout(function(){
    thinking.row.remove();
    try{if(!window.hydraChat)throw new Error("The local chatbot bundle is not ready.");var response=window.hydraChat.answerHydraDsl({contractVersion:"1.0",requestId:newChatRequestId(),locale:"en",question:q,assistanceLevel:assistanceLevel||$("chatLevel").value,context:chatContext()});renderChatResponse(response,q);}
    catch(error){appendChatMessage("bot","I could not process that question locally. Please shorten it or check the Playground context.","error");console.error("Hydra DSL assistant error",error);}
    finally{setChatBusy(false);$("chatIn").focus();}
  },80);
}
var CHAT_Q=["Why does this transformation fail?","How do I filter text columns?","Which destinations support upsert?","How do I group and sum?"];
function renderChat(){$("chatSugg").innerHTML=CHAT_Q.map(function(q){return "<button class='q' type='button'>"+q+"</button>";}).join("");
  document.querySelectorAll('#chatSugg .q').forEach(function(el){el.onclick=function(){chatAsk(el.textContent,"explanation",true);};});
  appendChatMessage("bot","Hi! I use the current Playground DSL and its validation state to answer locally. No LLM or network request is used.","");}
$("chatSend").onclick=function(){chatAsk(undefined,undefined,true);};
