{
  "$defs": {
    "DestinationDefinition": {
      "description": "A destination: its connector type, its connection and how to load it.",
      "properties": {
        "connection": {
          "additionalProperties": true,
          "title": "Connection",
          "type": "object"
        },
        "load": {
          "$ref": "#/$defs/LoadConfig"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "load"
      ],
      "title": "DestinationDefinition",
      "type": "object"
    },
    "LoadConfig": {
      "description": "How to load a destination (the load section of destinations.yaml).\n\nFields:\n- table: target table or file\n- mode: append | replace | upsert\n- key: key columns (required with mode: upsert), a simple [id] or composite [region, product_id] key\n- batch_size: rows per batch (default 10,000)\n- atomic: all or nothing (true / false; default depends on the connector)\n\nExamples:\n    load:\n      table: orders\n      mode: append\n\n    load:\n      table: users\n      mode: upsert\n      key: [id]",
      "properties": {
        "atomic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atomic"
        },
        "batch_size": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 10,
          "title": "Batch Size",
          "type": "integer"
        },
        "collection": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "key": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "mode": {
          "$ref": "#/$defs/LoadMode",
          "default": "append"
        },
        "table": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        }
      },
      "title": "LoadConfig",
      "type": "object"
    },
    "LoadMode": {
      "description": "Load modes.\n\n- append: adds the rows (INSERT)\n- replace: empties then inserts (TRUNCATE + INSERT)\n- upsert: inserts, or updates when the key exists",
      "enum": [
        "append",
        "replace",
        "upsert"
      ],
      "title": "LoadMode",
      "type": "string"
    }
  },
  "$id": "https://hydra.local/schemas/0.20.1/manifests/destinations.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Racine du fichier destinations.yaml.\n\nExemple:\n    destinations:\n      dest_dwh:\n        type: mysql\n        connection: {...}\n        load:\n          table: orders\n          mode: upsert\n          key: [id]",
  "properties": {
