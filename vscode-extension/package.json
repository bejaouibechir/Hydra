{
  "name": "hydra-etl",
  "displayName": "HYDRA ETL",
  "description": "Autocompletion, validation and snippets for HYDRA ETL manifests, and the Hydra ETL MCP server for the agents of VS Code (GitHub Copilot agent mode).",
  "version": "0.2.1",
  "publisher": "hydraetl",
  "author": {
    "name": "Bechir Bejaoui"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d0d0d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Snippets",
    "Linters",
    "Programming Languages",
    "AI"
  ],
  "keywords": [
    "hydra",
    "hydra etl",
    "etl",
    "yaml",
    "data pipeline",
    "hdrctl",
    "mcp",
    "copilot",
    "agent"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": [
          "sources.yaml",
          "sources.yml",
          "**/sources.yaml",
          "**/sources.yml"
        ],
        "url": "./schemas/sources.schema.json"
      },
      {
        "fileMatch": [
          "destinations.yaml",
          "destinations.yml",
          "**/destinations.yaml",
          "**/destinations.yml"
        ],
        "url": "./schemas/destinations.schema.json"
      },
      {
        "fileMatch": [
          "pipeline.yaml",
          "pipeline.yml",
          "**/pipeline.yaml",
          "**/pipeline.yml"
        ],
        "url": "./schemas/pipeline.schema.json"
      },
      {
        "fileMatch": [
          "transformations.yaml",
          "transformations.yml",
          "**/transformations.yaml",
          "**/transformations.yml"
        ],
        "url": "./schemas/transformations.schema.json"
      },
      {
        "fileMatch": [
          "workflow.yaml",
          "workflow.yml",
          "**/workflow.yaml",
          "**/workflow.yml",
          "**/workflows/*.yaml",
          "**/workflows/*.yml"
        ],
        "url": "./schemas/workflow.schema.json"
      },
      {
        "fileMatch": [
          "parameters.yaml",
          "parameters.yml",
          "**/parameters.yaml",
          "**/parameters.yml"
        ],
        "url": "./schemas/parameters.schema.json"
      },
      {
        "fileMatch": [
          "**/environments/*.yaml",
          "**/environments/*.yml"
        ],
        "url": "./schemas/environment.schema.json"
      },
      {
        "fileMatch": [
          "**/.hydra/secrets.yaml",
          "**/.hydra/secrets.yml"
        ],
        "url": "./schemas/secrets-settings.schema.json"
      },
      {
        "fileMatch": [
          "triggers.yaml",
          "triggers.yml",
          "**/triggers.yaml",
          "**/triggers.yml"
        ],
        "url": "./schemas/triggers.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/hydra.json"
      }
    ],
    "configurationDefaults": {
      "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "hydraEtl.mcpServers",
        "label": "Hydra ETL"
      }
    ],
    "commands": [
      {
        "command": "hydraEtl.mcp.refresh",
        "title": "Hydra ETL: Refresh the MCP servers"
      },
      {
        "command": "hydraEtl.mcp.showLog",
        "title": "Hydra ETL: Show the log"
      }
    ],
    "configuration": {
      "title": "Hydra ETL",
      "properties": {
        "hydraEtl.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Offer the Hydra ETL MCP server to the agents of VS Code for the Hydra ETL folders of the workspace (folders with .hydra/, jobs/ or workflows/)."
        },
        "hydraEtl.mcp.python": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Python that runs the Hydra ETL MCP server. Empty: the `.venv` or `venv` of the folder, the interpreter of the Python extension, then `py -3`, `python`, `python3` on the PATH — the first one where `hydra-etl[mcp]` is installed."
        }
      }
    }
  },
  "homepage": "https://hydraetl.com"
}
