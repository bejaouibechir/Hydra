{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hydraetl.com/schemas/sources-v1.json",
  "title": "Hydra — sources.yaml",
  "description": "Data sources declared for a Hydra job.",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Hydra DSL version.",
      "default": "1.0",
      "examples": ["1.0"]
    },
    "sources": {
      "type": "object",
      "description": "Sources keyed by identifier. The identifier is what pipeline.yaml refers to in its 'from' field.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/sourceDefinition" }
    }
  },
  "definitions": {
    "sourceDefinition": {
      "type": "object",
      "required": ["type", "extract"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/definitions/connectorType" },
        "connection": {
          "type": "object",
          "description": "Connection settings. Values may reference an environment variable using the ${ENV:VARIABLE_NAME} syntax.",
          "additionalProperties": true
        },
        "extract": { "$ref": "#/definitions/extractConfig" },
        "schema": { "$ref": "#/definitions/schemaConfig" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["mysql", "mariadb", "postgresql", "postgres", "sqlserver", "mssql"] } },
            "required": ["type"]
          },
          "then": {
            "properties": { "connection": { "$ref": "#/definitions/sqlConnection" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "sqlite" } },
            "required": ["type"]
          },
          "then": {
            "required": ["connection"],
            "properties": { "connection": { "$ref": "#/definitions/sqliteConnection" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["postgresql_cdc", "postgres_cdc"] } },
            "required": ["type"]
          },
          "then": {
            "required": ["connection"],
            "properties": {
              "connection": { "$ref": "#/definitions/postgresCdcConnection" },
              "extract": {
                "required": ["table"],
                "not": { "required": ["query"] },
                "properties": {
                  "table": {
                    "type": "string",
                    "pattern": "^([A-Za-z_][A-Za-z0-9_$]*\\.)?[A-Za-z_][A-Za-z0-9_$]*$",
                    "description": "Table whose changes are read: table or schema.table (a CDC source reads a table, not a query).",
                    "examples": ["public.orders"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "snowflake" } },
            "required": ["type"]
          },
          "then": {
            "required": ["connection"],
            "properties": {
              "connection": { "$ref": "#/definitions/snowflakeConnection" },
              "extract": {
                "properties": {
                  "query": {
                    "pattern": "^\\s*(\\(|[Ww][Ii][Tt][Hh]\\b|[Ss][Ee][Ll][Ee][Cc][Tt]\\b|[Ss][Hh][Oo][Ww]\\b|[Dd][Ee][Ss][Cc])",
                    "description": "Read-only source: the query must start with SELECT, WITH, SHOW or DESCRIBE."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "mongodb" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "connection": { "$ref": "#/definitions/mongoConnection" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "web_api" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "connection": { "$ref": "#/definitions/webApiConnection" } }
          }
        }
      ]
    },

    "connectorType": {
      "description": "Connector type. The listed types are those registered in CONNECTOR_REGISTRY; mongodb, parquet and web_api require their optional dependencies.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "parquet",
            "mysql",
            "mariadb",
            "postgresql",
            "postgres",
            "sqlserver",
            "mssql",
            "sqlite",
            "snowflake",
            "postgresql_cdc",
            "postgres_cdc",
            "mongodb",
            "web_api"
          ],
          "enumDescriptions": [
            "CSV file — 'extract.table' holds the file path.",
            "JSON file — 'extract.table' holds the file path.",
            "Parquet file (optional dependency: pyarrow).",
            "MySQL database.",
            "MariaDB database (same connector as MySQL).",
            "PostgreSQL database.",
            "Alias for postgresql.",
            "Microsoft SQL Server database (optional dependency: pymssql).",
            "Alias for sqlserver.",
            "SQLite database file, built in: connection.path is the file (Hydra ETL 0.20+).",
            "Snowflake, read-only source (Hydra ETL 0.20+; pip install \"hydra-etl[snowflake]\"). Exact numbers, dates, time zones and JSON.",
            "Changes of a PostgreSQL table (inserts, updates, deletes) through logical replication (Hydra ETL 0.20+). Needs wal_level = logical and a role with REPLICATION.",
            "Alias for postgresql_cdc.",
            "MongoDB database (optional dependency: pymongo).",
            "Paginated HTTP API (optional dependency: requests)."
          ]
        },
        {
          "type": "string",
          "description": "Connector supplied by a plugin (plugins/connectors directory)."
        }
      ]
    },

    "sqlConnection": {
      "type": "object",
      "description": "SQL database connection.",
      "properties": {
        "host": {
          "type": "string",
          "description": "Server host.",
          "examples": ["localhost", "${ENV:DB_HOST}"]
        },
        "port": {
          "anyOf": [{ "type": "integer" }, { "type": "string" }],
          "description": "Server port. MySQL/MariaDB: 3306. PostgreSQL: 5432.",
          "examples": [3306, 5432, "${ENV:DB_PORT}"]
        },
        "database": {
          "type": "string",
          "description": "Database name.",
          "examples": ["${ENV:DB_NAME}"]
        },
        "user": {
          "type": "string",
          "description": "Database user.",
          "examples": ["${ENV:DB_USER}"]
        },
        "password": {
          "type": "string",
          "description": "Password. Never write it in plain text: use ${ENV:DB_PASS} together with an untracked .env file.",
          "examples": ["${ENV:DB_PASS}"]
        }
      },
      "additionalProperties": true
    },

    "sqliteConnection": {
      "type": "object",
      "description": "SQLite database file. Built in: nothing to install, no server.",
      "anyOf": [{ "required": ["path"] }, { "required": ["database"] }],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Database file, relative to the job folder (or absolute). A source file must exist; a destination file is created at the first batch.",
          "examples": ["../../data/app.db", "../../outputs/warehouse.db"]
        },
        "database": { "type": "string", "minLength": 1, "description": "Alias for 'path'." }
      }
    },

    "postgresCdcConnection": {
      "type": "object",
      "description": "PostgreSQL connection plus the replication slot and the publication. The slot only moves on after the destination has published, so a failed load reads the same changes again.",
      "required": ["user", "database", "slot", "publication"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "examples": ["${ENV:PG_HOST}", "localhost"] },
        "port": { "anyOf": [{ "type": "integer" }, { "type": "string" }], "default": 5432, "examples": [5432, "${ENV:PG_PORT}"] },
        "user": { "type": "string", "minLength": 1, "description": "Role with the REPLICATION attribute (ALTER ROLE … REPLICATION).", "examples": ["${ENV:PG_USER}"] },
        "password": { "type": "string", "description": "Never in plain text: use ${ENV:…}.", "examples": ["${ENV:PG_PASSWORD}"] },
        "database": { "type": "string", "minLength": 1, "examples": ["shop"] },
        "slot": {
          "type": "string", "pattern": "^([a-z_][a-z0-9_]{0,62}|\\$\\{.+\\}|\\{\\{.+\\}\\})$",
          "description": "Logical replication slot (pgoutput), one per job: lowercase letters, digits and '_'. Created at the first run unless create: false. Drop a slot that is no longer used: it keeps the server's WAL.",
          "examples": ["hydra_orders"]
        },
        "publication": {
          "type": "string", "pattern": "^([a-z_][a-z0-9_]{0,62}|\\$\\{.+\\}|\\{\\{.+\\}\\})$",
          "description": "Publication that contains the table: lowercase letters, digits and '_'. Created at the first run unless create: false.",
          "examples": ["hydra_orders"]
        },
        "create": { "type": "boolean", "default": true, "description": "Create the publication and the slot if they are missing." },
        "snapshot": { "type": "boolean", "default": true, "description": "First run: copy the whole table, then read the changes." },
        "lag_warning_mb": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "string" }], "default": 1024,
          "description": "Before each run, warn when the slot retains more WAL than this (in MB), or when less than this is left before max_slot_wal_keep_size invalidates it. 0: never warn. A slot invalidated by PostgreSQL always makes the run fail.",
          "examples": [1024, 4096]
        }
      }
    },

    "snowflakeConnection": {
      "type": "object",
      "description": "Snowflake account. Authenticate with a key pair (private_key_file) or a password; keep both out of the file with ${ENV:…} references.",
      "required": ["account", "user"],
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string", "minLength": 1,
          "description": "Account identifier (ORGNAME-ACCOUNTNAME) or locator with its region (xy12345.eu-central-2.aws), without https:// or .snowflakecomputing.com.",
          "examples": ["${ENV:SNOWFLAKE_ACCOUNT}", "MYORG-MYACCOUNT", "xy12345.eu-central-2.aws"]
        },
        "user": { "type": "string", "minLength": 1, "description": "Snowflake user, ideally a service user that can only read.", "examples": ["${ENV:SNOWFLAKE_USER}", "HYDRA_SVC"] },
        "password": { "type": "string", "description": "Password. Never in plain text: use ${ENV:…}. Prefer a key pair.", "examples": ["${ENV:SNOWFLAKE_PASSWORD}"] },
        "private_key_file": { "type": "string", "description": "Private key file (PKCS#8, .p8) for key-pair authentication.", "examples": ["${ENV:SNOWFLAKE_PRIVATE_KEY_FILE}", "~/.snowflake/rsa_key.p8"] },
        "private_key_file_pwd": { "type": "string", "description": "Passphrase of an encrypted private key file.", "examples": ["${ENV:SNOWFLAKE_KEY_PASSPHRASE}"] },
        "authenticator": { "type": "string", "description": "Authentication method other than password or key pair.", "examples": ["externalbrowser", "oauth"] },
        "token": { "type": "string", "description": "OAuth token (with authenticator: oauth)." },
        "warehouse": { "type": "string", "description": "Warehouse that runs the queries.", "examples": ["COMPUTE_WH"] },
        "database": { "type": "string", "examples": ["SALES"] },
        "schema": { "type": "string", "examples": ["PUBLIC"] },
        "role": { "type": "string", "examples": ["HYDRA_READER"] },
        "host": { "type": "string" },
        "port": { "anyOf": [{ "type": "integer" }, { "type": "string" }] },
        "protocol": { "type": "string", "enum": ["https", "http"] },
        "login_timeout": { "anyOf": [{ "type": "integer" }, { "type": "string" }], "description": "Seconds." },
        "network_timeout": { "anyOf": [{ "type": "integer" }, { "type": "string" }], "description": "Seconds." },
        "client_session_keep_alive": { "type": "boolean" },
        "session_parameters": { "type": "object", "description": "Snowflake session parameters. QUERY_TAG defaults to hydra-etl.", "additionalProperties": true },
        "column_case": {
          "type": "string", "enum": ["preserve", "lower"], "default": "preserve",
          "description": "lower: ORDER_ID becomes order_id (what PostgreSQL expects). Two columns that only differ by case are refused before any row is read."
        },
        "json": {
          "type": "string", "enum": ["parse", "text"], "default": "parse",
          "description": "VARIANT, OBJECT and ARRAY columns: parse = JSON values (JSONB in PostgreSQL), text = JSON text."
        },
        "arrow": { "type": "boolean", "default": true, "description": "Read Arrow batches when the driver provides them (same values either way)." }
      }
    },

    "mongoConnection": {
      "type": "object",
      "description": "MongoDB connection.",
      "properties": {
        "host": { "type": "string", "examples": ["${ENV:MONGO_HOST}"] },
        "port": {
          "anyOf": [{ "type": "integer" }, { "type": "string" }],
          "default": 27017,
          "examples": [27017]
        },
        "database": { "type": "string", "examples": ["${ENV:MONGO_DB}"] },
        "collection": {
          "type": "string",
          "description": "Default collection.",
          "examples": ["${ENV:MONGO_COLLECTION}"]
        },
        "user": { "type": "string" },
        "password": { "type": "string", "examples": ["${ENV:MONGO_PASS}"] }
      },
      "additionalProperties": true
    },

    "webApiConnection": {
      "type": "object",
      "description": "HTTP API connection.",
      "properties": {
        "base_url": {
          "type": "string",
          "description": "API root. The endpoint path goes in extract.table.",
          "examples": ["https://api.example.com", "${ENV:API_BASE_URL}"]
        },
        "auth": {
          "type": "object",
          "description": "Authentication settings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["bearer", "basic", "api_key", "none"],
              "description": "Authentication scheme."
            },
            "token": { "type": "string", "examples": ["${ENV:API_TOKEN}"] },
            "user": { "type": "string" },
            "password": { "type": "string" }
          },
          "additionalProperties": true
        },
        "pagination": {
          "type": "object",
          "description": "Pagination strategy.",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["cursor", "offset", "page", "none"],
              "description": "cursor: follows a cursor field. offset/page: increments a query parameter."
            },
            "cursor_field": {
              "type": "string",
              "description": "Response field holding the next cursor.",
              "examples": ["next_cursor"]
            },
            "page_size": { "type": "integer", "minimum": 1, "examples": [100] }
          },
          "additionalProperties": true
        },
        "headers": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },

    "extractConfig": {
      "type": "object",
      "description": "What to read from the source. At least one of 'table', 'query' or 'collection' is required.",
      "anyOf": [
        { "required": ["table"] },
        { "required": ["query"] },
        { "required": ["collection"] }
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "description": "Table to read. For file connectors (csv, json, parquet): the file path, relative to the job directory. For web_api: the endpoint path.",
          "examples": ["orders", "data/input.csv", "/v1/records"]
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "SQL query to run, as an alternative to 'table'. Use a literal block | for multi-line queries.",
          "examples": ["SELECT id, name FROM orders WHERE status = 'paid'"]
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "description": "MongoDB collection to read."
        },
        "filter": {
          "type": "object",
          "description": "MongoDB filter applied while reading.",
          "additionalProperties": true,
          "examples": [{ "status": "active" }]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of rows to read. Useful to smoke-test a job before a full run."
        },
        "batch_size": {
          "type": "integer",
          "minimum": 10,
          "default": 10000,
          "description": "Rows read per batch. Minimum 10. Lower it under memory pressure, raise it to speed up large volumes.",
          "examples": [1000, 10000, 50000]
        }
      }
    },

    "schemaConfig": {
      "type": "object",
      "description": "Schema handling for sources without a fixed schema (MongoDB, JSON, HTTP APIs).",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "manual", "infer_strict", "hybrid"],
          "default": "auto",
          "description": "How the schema is determined.",
          "enumDescriptions": [
            "auto — inferred from a sample of documents.",
            "manual — only the declared fields are read.",
            "infer_strict — inferred once, then frozen.",
            "hybrid — declared fields plus inference for the rest."
          ]
        },
        "fields": {
          "type": "array",
          "description": "Explicitly declared fields. Required in manual mode.",
          "items": { "$ref": "#/definitions/schemaField" }
        },
        "drift_policy": {
          "type": "string",
          "enum": ["fail", "warn", "ignore", "adapt"],
          "default": "warn",
          "description": "What to do when the observed schema differs from the expected one. In production prefer 'fail', so incomplete data is never loaded silently.",
          "enumDescriptions": [
            "fail — stop the job.",
            "warn — log a warning and continue.",
            "ignore — say nothing and continue.",
            "adapt — accept the new schema."
          ]
        },
        "validation_policy": {
          "type": "string",
          "enum": ["strict", "best_effort", "permissive"],
          "default": "best_effort",
          "description": "How non-conforming rows are handled.",
          "enumDescriptions": [
            "strict — any non-conforming row fails the job.",
            "best_effort — convert where possible.",
            "permissive — no checking at all."
          ]
        },
        "sample_size": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "Number of documents sampled to infer the schema. Raise it when documents are heterogeneous."
        }
      }
    },

    "schemaField": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Name of the resulting column." },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Target type of the field.",
          "examples": ["int", "float", "str", "bool", "date", "datetime"]
        },
        "path": {
          "type": "string",
          "description": "Access path inside a nested document, in dotted notation.",
          "examples": ["customer.address.city"]
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "When true, a missing field is handled according to validation_policy."
        },
        "default": { "description": "Value used when the field is absent." },
        "array_handling": {
          "type": "string",
          "enum": ["keep", "flatten", "explode", "json"],
          "description": "How array values are handled.",
          "enumDescriptions": [
            "keep — keep the list as-is.",
            "flatten — spread into indexed columns.",
            "explode — one row per element.",
            "json — serialise to a JSON string."
          ]
        },
        "description": { "type": "string", "description": "Free-form documentation for the field." }
      }
    }
  }
}
