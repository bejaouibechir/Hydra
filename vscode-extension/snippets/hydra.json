{
  "Hydra — full sources.yaml": {
    "prefix": "hsources",
    "description": "Complete sources.yaml skeleton",
    "body": [
      "version: \"1.0\"",
      "sources:",
      "  src_${1:name}:",
      "    type: ${2|csv,json,parquet,mysql,mariadb,postgresql,mongodb,web_api|}",
      "    extract:",
      "      table: ${3:data/input.csv}",
      "      batch_size: ${4:10000}",
      "$0"
    ]
  },

  "Hydra — CSV source": {
    "prefix": "hsrc-csv",
    "description": "CSV file source",
    "body": [
      "src_${1:name}:",
      "  type: csv",
      "  extract:",
      "    table: ${2:data/input.csv}",
      "    batch_size: ${3:50000}",
      "$0"
    ]
  },

  "Hydra — MySQL / MariaDB source": {
    "prefix": "hsrc-mysql",
    "description": "MySQL or MariaDB source using environment variables",
    "body": [
      "src_${1:name}:",
      "  type: ${2|mysql,mariadb|}",
      "  connection:",
      "    host: \\${ENV:DB_HOST}",
      "    port: 3306",
      "    database: \\${ENV:DB_NAME}",
      "    user: \\${ENV:DB_USER}",
      "    password: \\${ENV:DB_PASS}",
      "  extract:",
      "    ${3|table,query|}: ${4:source_table}",
      "    batch_size: ${5:10000}",
      "$0"
    ]
  },

  "Hydra — PostgreSQL source": {
    "prefix": "hsrc-pg",
    "description": "PostgreSQL source using environment variables",
    "body": [
      "src_${1:name}:",
      "  type: postgresql",
      "  connection:",
      "    host: \\${ENV:PG_HOST}",
      "    port: 5432",
      "    database: \\${ENV:PG_DB}",
      "    user: \\${ENV:PG_USER}",
      "    password: \\${ENV:PG_PASS}",
      "  extract:",
      "    ${2|table,query|}: ${3:source_table}",
      "    batch_size: ${4:10000}",
      "$0"
    ]
  },

  "Hydra — MongoDB source": {
    "prefix": "hsrc-mongo",
    "description": "MongoDB source with schema inference",
    "body": [
      "src_${1:name}:",
      "  type: mongodb",
      "  connection:",
      "    host: \\${ENV:MONGO_HOST}",
      "    port: 27017",
      "    database: \\${ENV:MONGO_DB}",
      "  extract:",
      "    collection: ${2:my_collection}",
      "    batch_size: ${3:1000}",
      "  schema:",
      "    mode: ${4|auto,manual,infer_strict,hybrid|}",
      "    drift_policy: ${5|warn,fail,ignore,adapt|}",
      "    sample_size: ${6:100}",
      "$0"
    ]
  },

  "Hydra — HTTP API source": {
    "prefix": "hsrc-api",
    "description": "web_api source with authentication and pagination",
    "body": [
      "src_${1:name}:",
      "  type: web_api",
      "  connection:",
      "    base_url: \\${ENV:API_BASE_URL}",
      "    auth:",
      "      type: ${2|bearer,basic,api_key,none|}",
      "      token: \\${ENV:API_TOKEN}",
      "    pagination:",
      "      strategy: ${3|cursor,offset,page,none|}",
      "      cursor_field: ${4:next_cursor}",
      "      page_size: ${5:100}",
      "  extract:",
      "    table: ${6:/v1/records}",
      "    batch_size: ${7:100}",
      "$0"
    ]
  },

  "Hydra — full destinations.yaml": {
    "prefix": "hdestinations",
    "description": "Complete destinations.yaml skeleton",
    "body": [
      "version: \"1.0\"",
      "destinations:",
      "  dst_${1:name}:",
      "    type: ${2|csv,json,parquet,mysql,mariadb,postgresql,mongodb|}",
      "    load:",
      "      table: ${3:data/output.csv}",
      "      mode: ${4|append,replace,upsert|}",
      "$0"
    ]
  },

  "Hydra — CSV destination": {
    "prefix": "hdst-csv",
    "description": "CSV file destination",
    "body": [
      "dst_${1:name}:",
      "  type: csv",
      "  load:",
      "    table: ${2:data/output.csv}",
      "    mode: ${3|replace,append|}",
      "$0"
    ]
  },

  "Hydra — SQL destination in upsert mode": {
    "prefix": "hdst-upsert",
    "description": "SQL destination in upsert mode (key required)",
    "body": [
      "dst_${1:name}:",
      "  type: ${2|mysql,mariadb,postgresql|}",
      "  connection:",
      "    host: \\${ENV:DB_HOST}",
      "    port: ${3|3306,5432|}",
      "    database: \\${ENV:DB_NAME}",
      "    user: \\${ENV:DB_USER}",
      "    password: \\${ENV:DB_PASS}",
      "  load:",
      "    table: ${4:target_table}",
      "    mode: upsert",
      "    key: [${5:id}]",
      "    batch_size: ${6:5000}",
      "$0"
    ]
  },

  "Hydra — pipeline.yaml": {
    "prefix": "hpipeline",
    "description": "Wire a source to a destination",
    "body": [
      "version: \"1.0\"",
      "pipeline:",
      "  from: ${1:src_name}",
      "  to: ${2:dst_name}",
      "$0"
    ]
  },

  "Hydra — full transformations.yaml": {
    "prefix": "htransformations",
    "description": "Complete transformations.yaml skeleton",
    "body": [
      "version: \"1.0\"",
      "steps:",
      "  - select:",
      "      columns: [${1:id, name}]",
      "$0"
    ]
  },

  "Hydra — select step": {
    "prefix": "hselect",
    "description": "Keep only certain columns",
    "body": ["- select:", "    columns: [${1:id, name}]", "$0"]
  },

  "Hydra — filter step": {
    "prefix": "hfilter",
    "description": "Filter rows",
    "body": ["- filter:", "    expr: \"${1:amount > 0}\"", "$0"]
  },

  "Hydra — rename step": {
    "prefix": "hrename",
    "description": "Rename columns",
    "body": [
      "- rename:",
      "    mapping:",
      "      ${1:old_name}: ${2:new_name}",
      "$0"
    ]
  },

  "Hydra — cast step": {
    "prefix": "hcast",
    "description": "Convert column types",
    "body": [
      "- cast:",
      "    mapping:",
      "      ${1:column}: ${2|int,float,str,bool,date,datetime|}",
      "$0"
    ]
  },

  "Hydra — calculate step": {
    "prefix": "hcalculate",
    "description": "Add a computed column",
    "body": [
      "- calculate:",
      "    column: ${1:new_column}",
      "    expr: \"${2:price * quantity}\"",
      "$0"
    ]
  },

  "Hydra — sort step": {
    "prefix": "hsort",
    "description": "Sort rows",
    "body": [
      "- sort:",
      "    by: [${1:created_at}]",
      "    ascending: ${2|true,false|}",
      "$0"
    ]
  },

  "Hydra — deduplicate step": {
    "prefix": "hdedup",
    "description": "Remove duplicate rows",
    "body": [
      "- deduplicate:",
      "    columns: [${1:email}]",
      "    keep: ${2|first,last,none|}",
      "$0"
    ]
  },

  "Hydra — clean step": {
    "prefix": "hclean",
    "description": "Clean text columns",
    "body": [
      "- clean:",
      "    columns: [${1:name}]",
      "    case: ${2|none,lower,upper|}",
      "$0"
    ]
  },

  "Hydra — fill_null step": {
    "prefix": "hfillnull",
    "description": "Replace missing values",
    "body": [
      "- fill_null:",
      "    columns:",
      "      ${1:column}: ${2:0}",
      "$0"
    ]
  },

  "Hydra — aggregate step": {
    "prefix": "haggregate",
    "description": "Group and aggregate",
    "body": [
      "- aggregate:",
      "    by: [${1:region}]",
      "    agg:",
      "      ${2:total}:",
      "        func: ${3|sum,count,mean,avg,min,max,first,last|}",
      "        col: ${4:amount}",
      "$0"
    ]
  },

  "Hydra — join step": {
    "prefix": "hjoin",
    "description": "Join with a declared source",
    "body": [
      "- join:",
      "    right: ${1:src_reference}",
      "    key: ${2:id}",
      "    how: ${3|inner,left,right,outer|}",
      "$0"
    ]
  },

  "Hydra — cross join step": {
    "prefix": "hcrossjoin",
    "description": "Every row × every row of a declared source (cartesian product)",
    "body": [
      "- join:",
      "    right: ${1:calendar}",
      "    how: cross",
      "    max_rows: ${2:10000000}",
      "$0"
    ]
  },

  "Hydra — union step": {
    "prefix": "hunion",
    "description": "Stack a second stream",
    "body": [
      "- union:",
      "    right: ${1:src_other}",
      "    distinct: ${2|false,true|}",
      "$0"
    ]
  },

  "Hydra — merge step": {
    "prefix": "hmerge",
    "description": "Upsert between two streams",
    "body": [
      "- merge:",
      "    right: ${1:src_reference}",
      "    key: ${2:id}",
      "    delete_unmatched: ${3|false,true|}",
      "$0"
    ]
  },

  "Hydra — pivot step": {
    "prefix": "hpivot",
    "description": "Long to wide",
    "body": [
      "- pivot:",
      "    index: [${1:date}]",
      "    column: ${2:product}",
      "    values: ${3:amount}",
      "    aggfunc: ${4|first,sum,mean,min,max,count|}",
      "$0"
    ]
  },

  "Hydra — unpivot step": {
    "prefix": "hunpivot",
    "description": "Wide to long",
    "body": [
      "- unpivot:",
      "    id_vars: [${1:date}]",
      "    var_name: ${2:variable}",
      "    value_name: ${3:value}",
      "$0"
    ]
  },

  "Hydra — text_to_rows step": {
    "prefix": "htexttorows",
    "description": "One row per value of a text column",
    "body": [
      "- text_to_rows:",
      "    column: ${1:tags}",
      "    sep: \"${2:;}\"",
      "    index_column: ${3:tag_pos}",
      "$0"
    ]
  },

  "Hydra — window step": {
    "prefix": "hwindow",
    "description": "Window functions: rank, lag/lead, running totals, partition totals",
    "body": [
      "- window:",
      "    partition_by: [${1:customer_id}]",
      "    order_by: [${2:order_date}]",
      "    columns:",
      "      ${3:order_rank}: {func: ${4|row_number,rank,dense_rank|}}",
      "      ${5:prev_amount}: {func: ${6|lag,lead|}, col: ${7:amount}, default: ${8:0}}",
      "      ${9:running_total}: {func: ${10|cumsum,cumcount,cummin,cummax|}, col: ${11:amount}}",
      "      ${12:customer_total}: {func: ${13|sum,mean,min,max,count,first,last|}, col: ${14:amount}}",
      "$0"
    ]
  },

  "Hydra — script step": {
    "prefix": "hscript",
    "description": "Custom Python transformation",
    "body": [
      "- script:",
      "    inputs: [${1:price, quantity}]",
      "    outputs:",
      "      ${2:total}: ${3|float,int,str,bool,date,datetime,any|}",
      "    mode: ${4|vectorized,row|}",
      "    code: |",
      "      ${5:total = price * quantity}",
      "$0"
    ]
  },

  "Hydra — full workflow.yaml": {
    "prefix": "hworkflow",
    "description": "Complete workflow.yaml skeleton",
    "body": [
      "workflow:",
      "  name: \"${1:my_workflow}\"",
      "  description: \"${2:What this workflow does}\"",
      "  trigger:",
      "    type: ${3|manual,schedule,webhook|}",
      "  steps:",
      "    - name: \"${4:extract}\"",
      "      type: job",
      "      job: \"./jobs/${4:extract}\"",
      "      depends_on: []",
      "      on_failure: ${5|fail,skip,continue|}",
      "$0"
    ]
  },

  "Hydra — workflow job step": {
    "prefix": "hstep-job",
    "description": "Step running a Hydra job",
    "body": [
      "- name: \"${1:step_name}\"",
      "  type: job",
      "  job: \"./jobs/${1:step_name}\"",
      "  depends_on: [${2}]",
      "  on_failure: ${3|fail,skip,continue|}",
      "$0"
    ]
  },

  "Hydra — workflow action step": {
    "prefix": "hstep-action",
    "description": "Step running a built-in action",
    "body": [
      "- name: \"${1:notify}\"",
      "  type: action",
      "  action: ${2|log,delay,condition,webhook,email,bash,powershell,ssh,python,set_param,assign_param|}",
      "  params:",
      "    ${3:message}: \"${4:Workflow finished.}\"",
      "  depends_on: [${5}]",
      "  on_failure: ${6|skip,fail,continue|}",
      "$0"
    ]
  },

  "Hydra — workflow project step": {
    "prefix": "hstep-project",
    "description": "Step running another Hydra project (sub-project)",
    "body": [
      "- name: \"${1:sub_project}\"",
      "  type: project",
      "  project: \"${2:../${1:sub_project}}\"",
      "  env: ${3|inherit,none,dev,prod|}",
      "  params:",
      "    ${4:batch_date}: \"${5:{{ param:run_date \\}\\}}\"",
      "  isolation: ${6|inprocess,subprocess|}",
      "  overlap: ${7|wait,skip,fail|}",
      "  depends_on: [${8}]",
      "  on_failure: ${9|fail,skip,continue|}",
      "$0"
    ]
  },

  "Hydra — workflow step with retries": {
    "prefix": "hstep-retry",
    "description": "Step with a retry policy",
    "body": [
      "- name: \"${1:step_name}\"",
      "  type: job",
      "  job: \"./jobs/${1:step_name}\"",
      "  depends_on: [${2}]",
      "  on_failure: fail",
      "  retry:",
      "    max: ${3:3}",
      "    delay: ${4:5}",
      "    backoff: ${5|exponential,fixed|}",
      "$0"
    ]
  },

  "Hydra — scheduled trigger": {
    "prefix": "htrigger-cron",
    "description": "Cron-scheduled trigger",
    "body": [
      "trigger:",
      "  type: schedule",
      "  cron: \"${1|0 8 * * *,0 2 * * *,*/15 * * * *,0 0 * * 1|}\"",
      "$0"
    ]
  },

  "Hydra — triggers.yaml": {
    "prefix": "htriggers",
    "description": "triggers.yaml with one cron trigger",
    "body": [
      "version: \"1.0\"",
      "triggers:",
      "  - name: \"${1:nightly}\"",
      "    type: cron",
      "    cron: \"${2|0 2 * * *,0 8 * * mon-fri,*/15 * * * *|}\"",
      "    workflows: [${3}]",
      "$0"
    ]
  },

  "Hydra — project trigger: cron": {
    "prefix": "hptrig-cron",
    "description": "Run the project at given times",
    "body": [
      "- name: \"${1:nightly}\"",
      "  type: cron",
      "  cron: \"${2|0 2 * * *,0 8 * * mon-fri,*/15 * * * *|}\"",
      "  timezone: ${3:Europe/Paris}",
      "  env: ${4:prod}",
      "$0"
    ]
  },

  "Hydra — project trigger: interval": {
    "prefix": "hptrig-interval",
    "description": "Run the project every N minutes",
    "body": [
      "- name: \"${1:every_15m}\"",
      "  type: interval",
      "  every: ${2:15m}",
      "$0"
    ]
  },

  "Hydra — project trigger: file": {
    "prefix": "hptrig-file",
    "description": "Run the project when a file arrives",
    "body": [
      "- name: \"${1:new_orders}\"",
      "  type: file",
      "  path: ${2:inbox/*.csv}",
      "  events: [${3|added,added\\, modified|}]",
      "  debounce: ${4:2s}",
      "$0"
    ]
  },

  "Hydra — project trigger: marker": {
    "prefix": "hptrig-marker",
    "description": "Run the project when a marker file appears",
    "body": [
      "- name: \"${1:ready}\"",
      "  type: marker",
      "  path: ${2:inbox/READY}",
      "  consume: ${3|true,false|}",
      "$0"
    ]
  },

  "Hydra — project trigger: source change": {
    "prefix": "hptrig-source",
    "description": "Run the project when a source changes",
    "body": [
      "- name: \"${1:orders_changed}\"",
      "  type: source_change",
      "  source: {job: ${2:jobs/ingest}, id: ${3:orders}, check: ${4|count,checksum|}}",
      "  every: ${5:1m}",
      "$0"
    ]
  },

  "Hydra — project trigger: webhook": {
    "prefix": "hptrig-webhook",
    "description": "Run the project on an HTTP call with a token (hdrctl trigger token NAME)",
    "body": [
      "- name: \"${1:on_push}\"",
      "  type: webhook",
      "  token: \\${SECRET:trigger.${1:on_push}.token}",
      "$0"
    ]
  },

  "Hydra — project trigger: after another project": {
    "prefix": "hptrig-after",
    "description": "Run the project when another one ends",
    "body": [
      "- name: \"${1:after_crm}\"",
      "  type: after_project",
      "  project: ${2:../crm}",
      "  on: ${3|success,failure,any|}",
      "$0"
    ]
  },

  "Hydra — full parameters.yaml": {
    "prefix": "hparams",
    "description": "parameters.yaml with one parameter (type, default, description)",
    "body": [
      "version: \"1.0\"",
      "parameters:",
      "  ${1:batch_size}:",
      "    type: ${2|int,string,float,bool,json,any|}",
      "    default: ${3:500}",
      "    description: ${4:Rows read per batch}",
      "$0"
    ]
  },

  "Hydra — parameter declaration": {
    "prefix": "hparam",
    "description": "One parameter of parameters.yaml",
    "body": [
      "${1:name}:",
      "  type: ${2|string,int,float,bool,json,any|}",
      "  default: ${3}",
      "  required: ${4|false,true|}",
      "  description: ${5}",
      "$0"
    ]
  },

  "Hydra — environments/<env>.yaml": {
    "prefix": "henv",
    "description": "Parameter values of one environment",
    "body": [
      "parameters:",
      "  ${1:batch_size}: ${2:5000}",
      "$0"
    ]
  },

  "Hydra — .hydra/secrets.yaml with SOPS": {
    "prefix": "hsecrets-sops",
    "description": "Secrets settings: visibility and SOPS-encrypted file per environment",
    "body": [
      "visibility: ${1|masked,hidden,plain|}",
      "provider: sops",
      "sops:",
      "  file: ${2:.hydra/secrets.{env}.sops.yaml}",
      "$0"
    ]
  },

  "Hydra — parameter reference": {
    "prefix": "hrefparam",
    "description": "{{ param:NAME }} — value of a parameter for the active environment",
    "body": ["{{ param:${1:name} }}$0"]
  },

  "Hydra — secret reference": {
    "prefix": "hrefsecret",
    "description": "${SECRET:NAME} — secret of .hydra/secrets(.<env>), an environment variable or the provider",
    "body": ["\\${SECRET:${1:db.password}}$0"]
  },

  "Hydra — environment variable reference": {
    "prefix": "hrefenv",
    "description": "${ENV:NAME} — required environment variable (~/.hydra/env, env.<env>, .env, --env-file)",
    "body": ["\\${ENV:${1:DB_HOST}}$0"]
  }
}
